# ============================================================
# CBT.AI Backend Environment Configuration
# Template file with placeholders only — NO real secrets.
# Copy this file to .env and configure for your environment.
# ============================================================

# ── Server & Runtime ──────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Allowed Frontend Origin (Strict CORS) ─────────────────────
# Comma-separated list of allowed frontend origins (e.g. Cloudflare Pages domain)
ALLOWED_ORIGIN=https://cbt-ai.pages.dev,http://localhost:4173,http://localhost:5173

# ── Zero-Paid AI Enforcement ──────────────────────────────────
# When true: excludes all paid-only models and forbids automatic billing
FREE_ONLY=true

# ── Admin Diagnostics Authentication ──────────────────────────
# Secret key required to access /api/health/diagnostics
ADMIN_API_KEY=your-secure-admin-secret-key-here

# ── Rate Limiting & Abuse Prevention ─────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
GENERATION_LIMIT_WINDOW_MS=3600000
GENERATION_LIMIT_MAX=10

# ── Job Queue & Concurrency Controls ─────────────────────────
# Hard generation timeout (8 minutes maximum = 480,000ms)
JOB_TIMEOUT_MS=480000
JOB_MAX_CONCURRENT=3
JOB_MAX_QUEUE_SIZE=20

# ── Provider Timeout & Cooldown ──────────────────────────────
# Timeout per individual provider attempt before triggering failover (in ms)
PROVIDER_TIMEOUT_MS=35000
PROVIDER_COOLDOWN_MS=120000

# ── FreeLLMAPI Unified Gateway (Private Internal Gateway) ─────
# Private internal URL where FreeLLMAPI runs (isolated Docker or private VPC)
FREELLMAPI_BASE_URL=http://freellmapi:8000
FREELLMAPI_API_KEY=sk-freellmapi-internal-token

# ── Direct Free-Tier Provider API Keys (Optional Fallbacks) ───
# Configure any credentials you legitimately hold for free-tier quotas:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# ── File Upload Constraints ───────────────────────────────────
MAX_FILE_SIZE_MB=25
ALLOWED_MIME_TYPES=application/pdf,text/plain,image/jpeg,image/png,image/webp

# ── Structured Logging ────────────────────────────────────────
LOG_LEVEL=info
