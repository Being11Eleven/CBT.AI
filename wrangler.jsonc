{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbt-ai",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "name": "cbt-exam-generator",
      "binding": "EXAM_WORKFLOW",
      "class_name": "ExamGenerationWorkflow"
    }
  ]
}
